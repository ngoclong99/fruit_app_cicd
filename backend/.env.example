# ============================================================
# Backend environment variables
# ============================================================
# Copy file này thành .env và điền giá trị thật cho máy của bạn.
# Schema validate ở backend/src/config/env.ts.
# ============================================================

# ── Environment ─────────────────────────────────────────────
NODE_ENV=development            # development | staging | production | test
PORT=5000
HOST=0.0.0.0                    # 0.0.0.0 để bind mọi interface (Docker friendly)

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todos_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=at-least-8-characters-please-change-in-prod
JWT_EXPIRES_IN=15m              # Access token NGẮN hạn (15m|1h...). Refresh token lo gia hạn.

# ── Security ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000     # 15 phút = 900,000 ms
RATE_LIMIT_MAX=300              # Số request tối đa / window / IP

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ── S3 lưu ảnh sản phẩm ─────────────────────────────────────
# Để trống = tắt tính năng upload/xoá ảnh S3 (app vẫn chạy bình thường).
S3_IMAGES_BUCKET=               # vd: myapp-product-images
S3_IMAGES_REGION=ap-southeast-1
CDN_IMAGES_URL=                 # vd: https://dxxxx.cloudfront.net

# ── AWS credentials — CHỈ dùng ở LOCAL ──────────────────────
# Trên EC2 KHÔNG cần (IAM Instance Role tự cấp credentials qua default chain).
# Ở máy local, SDK tự đọc 2 biến này từ .env để gọi S3. Cách khác: chạy
# `aws configure` để lưu vào ~/.aws/credentials (cũng được default chain đọc).
# LƯU Ý: chỉ điền key, KHÔNG để '' rỗng nếu deploy — env rỗng sẽ chặn IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
